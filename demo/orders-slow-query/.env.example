# 本文件仅说明本地 PostgreSQL 靶场所需变量；请复制为 .env 后自行加载，勿提交真实密码。
# 靶场脚本拒绝访问除 127.0.0.1:5433 / opermind_demo 之外的目标。
OPERMIND_DEMO_PG_HOST=127.0.0.1
OPERMIND_DEMO_PG_PORT=5433
OPERMIND_DEMO_PG_DATABASE=opermind_demo
OPERMIND_DEMO_PG_USER=<your-local-tunnel-user>
OPERMIND_DEMO_PG_PASSWORD=<set-in-local-environment-only>

# 可按机器能力调大；改动后先执行 clean，再重新 start。
OPERMIND_DEMO_ORDER_COUNT=300000
OPERMIND_DEMO_SLOW_QUERY_THRESHOLD_MS=60000
