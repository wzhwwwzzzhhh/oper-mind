{
  "name": "opermind-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/v1/generated.ts",
    "mock:api": "..\\.venv\\Scripts\\python.exe scripts/mock_v1_api.py",
    "test:mock-api": "..\\.venv\\Scripts\\python.exe -m pytest scripts/test_mock_v1_api.py -q"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@tanstack/react-query": "^5.90.20",
    "antd": "^6.3.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.13.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^27.0.0",
    "msw": "^2.11.6",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^4.1.10"
  }
}
